# Copy to .env and fill in your MySQL credentials (same as in MySQL Workbench)
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bonmarche
CORS_ORIGIN=http://localhost:5173

# Facebook / Instagram posts on the home page (GET /api/social) – how to get these: server/SOCIAL-SETUP.md
# Leave empty and the home page shows its sample posts.
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
# optional: Graph API version, minutes between checks for new posts
# FB_GRAPH_VERSION=v24.0
# SOCIAL_CACHE_MINUTES=10
